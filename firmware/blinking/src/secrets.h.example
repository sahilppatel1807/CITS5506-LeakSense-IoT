// LeakSense - Smart LPG Gas Leakage Detection and Automatic Safety System
// Copy this file to secrets.h and replace the placeholder values below.
// secrets.h is ignored by Git so Wi-Fi and Firebase credentials stay private.
#pragma once

// Wi-Fi credentials used by the ESP32 for Firebase uploads.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Firebase Realtime Database host and database secret used by REST requests.
#define FIREBASE_HOST "YOUR_PROJECT-default-rtdb.firebaseio.com"
#define FIREBASE_AUTH "YOUR_REALTIME_DATABASE_SECRET"
