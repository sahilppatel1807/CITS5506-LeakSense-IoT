        <mxCell id="e10" value="Yes, force alarm" edge="1" source="extreme" target="danger" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="795" /></Array></mxGeometry></mxCell>
