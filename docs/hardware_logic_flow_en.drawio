        <mxCell id="e15" value="No, keep yellow LED on" edge="1" source="confirmDanger" target="warning" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2"><mxGeometry relative="1" as="geometry" /></mxCell>
